---
import { mapStores } from '../data/map-stores';
---

<div class="xesta-map-shell">
    <div id="xesta-map" class="xesta-map" data-stores={JSON.stringify(mapStores)}></div>
</div>

<script>
    const mount = document.getElementById('xesta-map');
    if (mount && !mount.dataset.ready) {
        mount.dataset.ready = '1';

        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);

        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.onload = () => {
            const L = (window as Window & { L: any }).L;
            const stores = JSON.parse(mount.dataset.stores || '[]');

            const map = L.map(mount, {
                scrollWheelZoom: false,
                zoomControl: false
            });

            L.control.zoom({ position: 'topright' }).addTo(map);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 19
            }).addTo(map);

            const icon = L.divIcon({
                className: 'xesta-map-pin',
                html: '<img src="/img/map/tienda-mark.svg" width="44" height="44" alt="">',
                iconSize: [44, 44],
                iconAnchor: [22, 22],
                popupAnchor: [0, -22]
            });

            const bounds = [];

            for (const store of stores) {
                const marker = L.marker([store.lat, store.lng], { icon, title: `${store.name} · ${store.town}` });
                marker.bindPopup(
                    `<p class="xesta-map-popup-kicker">${store.town}</p>
                     <p class="xesta-map-popup-title">${store.name}</p>
                     <p class="xesta-map-popup-addr">${store.address}<br>${store.postcode}</p>`,
                    { className: 'xesta-map-popup' }
                );
                marker.addTo(map);
                bounds.push([store.lat, store.lng]);
            }

            if (bounds.length) {
                map.fitBounds(bounds, { padding: [48, 48], maxZoom: 12 });
            }

            setTimeout(() => map.invalidateSize(), 200);

            map.scrollWheelZoom.disable();
            mount.addEventListener('click', () => map.scrollWheelZoom.enable());
        };
        document.head.appendChild(script);
    }
</script>
