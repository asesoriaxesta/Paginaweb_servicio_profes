---
import Layout from '../layouts/Layout.astro';
import CtaButton from '../components/CtaButton.astro';
import { EMAIL, PHONE_DISPLAY, PHONE_TEL, mailtoHref } from '../lib/cta';

const includes = [
    'Contabilidad de tu negocio, acorde a las directrices de Hacienda',
    'Libros contables',
    'Renta anual*',
    'Control de la cuota de autónomo, ajustada a rendimientos',
    'Resolución de dudas relativas a la actividad'
];
---

<Layout title="Pack para profesorado artístico | Asesoría Xesta">
    <section class="px-4 pt-2 sm:px-8 lg:px-10">
        <div class="relative mx-auto min-h-[72vh] max-w-[1400px] overflow-hidden rounded-[2rem] sm:rounded-[2.5rem]">
            <img
                src="/img/sesion-17.jpg"
                alt="Manos tocando la gaita, de una sesión de Asesoría Xesta"
                width="1600"
                height="1067"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>
            <div class="relative flex min-h-[72vh] max-w-3xl flex-col justify-end p-8 sm:p-12 lg:p-16">
                <p class="font-heading text-sm font-bold uppercase tracking-[0.16em] text-white/80">
                    Profesorado artístico
                </p>
                <h1 class="mt-3 text-white">A la medida de quien vive de enseñar.</h1>
                <p class="mt-4 max-w-lg text-base text-white/90 sm:text-lg">
                    Formación artística, IVA exento y la mayor parte de tus ingresos con retención. Comprobamos si este
                    pack te encaja.
                </p>
                <div class="mt-8">
                    <CtaButton size="lg">Quiero este pack</CtaButton>
                </div>
            </div>
        </div>
    </section>

    <section id="para-quien" class="section scroll-mt-24">
        <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
            <div>
                <h2 class="kicker">¿Para quién?</h2>
                <p class="mt-6 text-2xl font-bold leading-snug sm:text-3xl" style="font-family: var(--font-heading)">
                    Si eres profesora/o de música, danza, teatro o plástica y cumples estos puntos.
                </p>
                <ul class="mt-8 space-y-4 text-lg">
                    <li>Docencia <strong>exenta de IVA</strong></li>
                    <li>
                        Al menos el <strong>70 % de los ingresos</strong> con retención en factura
                    </li>
                </ul>
                <p class="mt-8">
                    <a class="link font-heading font-bold uppercase tracking-wide no-underline" href="/preguntas">
                        Cómo se calcula el 70 % →
                    </a>
                </p>
            </div>
            <img
                src="/img/sesion-3-3.jpg"
                alt="Taller de danza, sesión de Asesoría Xesta"
                width="1200"
                height="800"
                loading="lazy"
                class="photo aspect-[4/3]"
            />
        </div>
    </section>

    <section id="pack" class="section scroll-mt-24 pt-0">
        <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
            <div class="order-2 grid grid-cols-2 gap-4 lg:order-1">
                <img
                    src="/img/unsplash-pincel.jpg"
                    alt="Mano con pincel sobre una paleta de pintura"
                    width="800"
                    height="533"
                    loading="lazy"
                    class="photo aspect-[3/4]"
                />
                <img
                    src="/img/unsplash-torno.jpg"
                    alt="Manos dando forma al barro en un torno"
                    width="800"
                    height="533"
                    loading="lazy"
                    class="photo mt-8 aspect-[3/4]"
                />
            </div>
            <div class="order-1 lg:order-2">
                <h2 class="kicker">Qué hacemos</h2>
                <p class="mt-6 text-2xl font-bold leading-snug sm:text-3xl" style="font-family: var(--font-heading)">
                    Fiscalidad más sencilla y adaptada a tus necesidades.
                </p>
                <ul class="mt-8 space-y-3 text-lg">
                    {includes.map((item) => <li>{item}</li>)}
                </ul>
                <p class="mt-4 text-sm text-xesta-muted">
                    *Según rendimientos. Lo revisaremos cada ejercicio.
                </p>
                <p class="mt-6">
                    <a class="link font-heading font-bold uppercase tracking-wide no-underline" href="/preguntas">
                        Preguntas: IVA, retención y el 70 % →
                    </a>
                </p>
            </div>
        </div>
    </section>

    <section class="section pt-0">
        <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
            <div>
                <h2 class="kicker">Xesta</h2>
                <p class="mt-6 text-2xl font-bold leading-snug sm:text-3xl" style="font-family: var(--font-heading)">
                    Somos Iria e Iago, las mismas.
                </p>
                <p class="lede mt-5">
                    No es un servicio de menos nivel. Es el nuestro, adaptado a una actividad que nos da menos trabajo.
                    Misma gente, mismo cuidado; más ajustado a lo que esta forma de facturar pide.
                </p>
            </div>
            <img
                src="/img/sesion-23.jpg"
                alt="Momento de clase, sesión de Asesoría Xesta"
                width="1200"
                height="800"
                loading="lazy"
                class="photo aspect-[4/3]"
            />
        </div>
    </section>

    <section class="px-4 pb-16 sm:px-8 sm:pb-24 lg:px-10">
        <div
            class="relative mx-auto max-w-[1400px] overflow-hidden rounded-[2rem] bg-xesta-ink px-8 py-16 text-white sm:rounded-[2.5rem] sm:px-16 sm:py-20"
        >
            <h2 class="text-white">¿Hablamos?</h2>
            <p class="mt-4 max-w-lg text-lg text-white/80">
                Escríbenos y te decimos si el pack aplica. El precio, si encaja, en ese correo.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
                <CtaButton size="lg">Quiero este pack</CtaButton>
                <a href={`tel:${PHONE_TEL}`} class="btn btn-ghost text-white ring-white/40 hover:bg-white hover:text-xesta-ink">
                    {PHONE_DISPLAY}
                </a>
            </div>
            <p class="mt-6 text-sm text-white/60">
                <a class="text-white underline underline-offset-4" href={mailtoHref}>{EMAIL}</a>
            </p>
        </div>
    </section>
</Layout>
