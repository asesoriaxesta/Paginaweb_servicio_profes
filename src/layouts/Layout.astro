---
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaButton from '../components/CtaButton.astro';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'Pack de asesoría para profesorado de formación artística: docencia exenta de IVA e ingresos con retención. Comprobamos el encaje.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/webp" href="/favicon.webp" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&family=Titillium+Web:wght@600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="flex min-h-screen flex-col antialiased">
        <a class="skip-link" href="#contenido">Saltar al contenido</a>
        <Header />
        <main id="contenido" class="grow pb-20 md:pb-0">
            <slot />
        </main>
        <Footer />
        <div
            class="fixed inset-x-0 bottom-0 z-40 border-t border-xesta-line bg-white/95 p-3 backdrop-blur-md md:hidden"
            style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
        >
            <CtaButton class="w-full" size="lg">Escribir para ver si encaja</CtaButton>
        </div>
    </body>
</html>
